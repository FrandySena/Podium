<div class="top-row ps-3 navbar navbar-dark custom-sidebar-header">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center" href="home">
            <img src="/Resources/PodiumLogo.png" width="30" height="30" class="me-2";" />
            Podium.Web
        </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass custom-sidebar-body d-flex flex-column" @onclick="ToggleNavMenu">
    <nav class="nav flex-column flex-grow-1 nav-scrollable">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="home" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="participants">
                <span class="bi bi-people-fill" aria-hidden="true"></span> Participants
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="juries">
                <span class="bi bi-person-badge-fill" aria-hidden="true"></span> Juries
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="debates">
                <span class="bi bi-megaphone-fill" aria-hidden="true"></span> Debates
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="debates/details">
                <span class="bi bi-info-circle-fill" aria-hidden="true"></span> Debate Insights
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="debates/registry">
                <span class="bi bi-person-lines-fill" aria-hidden="true"></span> Assignments
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="topics">
                <span class="bi bi-journal-text" aria-hidden="true"></span> Topics
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="attendances">
                <span class="bi bi-clipboard-check-fill" aria-hidden="true"></span> Attendances
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="evaluations">
                <span class="bi bi-star-fill" aria-hidden="true"></span> Evaluations
            </NavLink>
        </div>
    </nav>

    <div class="px-3 pb-3">
        <div class="pt-3 border-top border-white-25">
            <NavLink class="nav-link d-flex align-items-center p-2" href="profile" style="background-color: rgba(255,255,255,0.05);">
                <div class="bg-primary rounded-circle d-flex justify-content-center align-items-center me-3 shadow-sm" style="width: 40px; height: 40px; min-width: 40px;">
                    <span class="text-white fw-bold">FS</span>
                </div>
                <div class="overflow-hidden">
                    <p class="mb-0 text-white fw-bold text-truncate" style="font-size: 0.85rem; line-height: 1.2;">Frandy Sena</p>
                    <p class="mb-0 text-white-50 x-small text-truncate">View Developer</p>
                </div>
            </NavLink>
        </div>
    </div>
</div>

<style>
    .custom-sidebar-header {
        background-color: #356ec7 !important;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        height: 3.5rem;
        display: flex;
        align-items: center;
    }

    .custom-sidebar-body {
        background-color: #134c9b !important;
        height: calc(100vh - 3.5rem);
        overflow: hidden;
    }

    .nav-scrollable {
        overflow-y: auto;
    }

    .nav-link {
        color: rgba(255,255,255,0.8) !important;
        border-radius: 6px;
        margin: 2px 0;
        transition: all 0.2s;
    }

        .nav-link:hover {
            background-color: rgba(255,255,255,0.1);
            color: white !important;
        }

        .nav-link.active {
            background-color: rgba(255,255,255,0.2) !important;
            color: white !important;
            font-weight: bold;
        }

    .bi {
        margin-right: 10px;
    }

    .x-small {
        font-size: 0.7rem;
    }

    .border-white-25 {
        border-color: rgba(255,255,255,0.25) !important;
    }
</style>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}