@page "/profile"

<div class="container mt-4" style="max-width: 800px;">
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="bg-primary p-5 text-center text-white">
            <div class="bg-white rounded-circle d-flex justify-content-center align-items-center mx-auto mb-3 shadow" style="width: 120px; height: 120px;">
                <span class="text-primary display-2 fw-bold">F</span>
            </div>
            <h2 class="fw-bold mb-1">Frandy Sena Taveras</h2>
            <p class="fs-5 opacity-75 mb-0">Software Developer</p>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-md-6">
                    <h5 class="fw-bold text-primary mb-3">
                        <i class="bi bi-person-badge-fill me-2"></i>Academic Info
                    </h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><strong>Institution:</strong> ITLA</li>
                        <li class="mb-2"><strong>Extimate Graduation:</strong> May 2027</li>
                        <li><strong>Specialization:</strong> Software Development</li>
                    </ul>
                </div>

                <div class="col-md-6">
                    <h5 class="fw-bold text-primary mb-3">
                        <i class="bi bi-code-slash me-2"></i>Technical Stack
                    </h5>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-light text-primary border border-primary">C# / .NET</span>
                        <span class="badge bg-light text-primary border border-primary">Python</span>
                        <span class="badge bg-light text-primary border border-primary">SQL Server</span>
                        <span class="badge bg-light text-primary border border-primary">C++</span>
                        <span class="badge bg-light text-primary border border-primary">SQLite</span>
                    </div>
                </div>

                <div class="col-12">
                    <hr class="text-muted opacity-25" />
                    <h5 class="fw-bold text-primary mb-3 text-center">Connect with me</h5>
                    <div class="d-flex justify-content-center gap-3">
                        <a href="https://github.com/FrandySena" target="_blank" class="btn btn-dark d-flex align-items-center px-4">
                            <i class="bi bi-github me-2"></i> GitHub
                        </a>
                        <a href="https://www.linkedin.com/in/frandysenataveras" target="_blank" class="btn btn-outline-primary d-flex align-items-center px-4">
                            <i class="bi bi-linkedin me-2"></i> LinkedIn
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .badge {
        font-size: 0.9rem;
        padding: 0.5rem 0.8rem;
    }
    .card {
        transition: transform 0.3s ease;
    }
</style>