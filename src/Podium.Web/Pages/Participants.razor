@page "/participants"
@using Podium.Application
@using Podium.Application.Dtos.Auth
@using Podium.Application.Responses
@inject HttpClient Http

<PageTitle>Participants Management - Podium</PageTitle>

<div class="container mt-4">
    @* Header Section with Title, Search and Create Button *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Participants Management</h1>
        <div class="d-flex gap-2">
            @* Search by ID Input Group *@
            <div class="input-group input-group-sm" style="width: 250px;">
                <input type="number" class="form-control" placeholder="Search by ID..." @bind="searchId" />
                <button class="btn btn-outline-primary" @onclick="FetchParticipantById">Search</button>
            </div>
            <button class="btn btn-success" @onclick="ShowCreateForm">New Participant</button>
        </div>
    </div>

    @* Alert for Search or Error Messages *@
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @* Detail View Card: Displays full info when a participant is selected or searched *@
    @if (showDetails && selectedParticipant != null)
    {
        <div class="card mb-4 border-info shadow-sm bg-light">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Participant Details (ID: @selectedParticipant.Id)</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseDetails"></button>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Full Name:</strong> @selectedParticipant.Name @selectedParticipant.LastName</p>
                        <p><strong>Email:</strong> @selectedParticipant.Email</p>
                        <p><strong>Age:</strong> @selectedParticipant.Age</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Phone:</strong> @selectedParticipant.Phone</p>
                        <p><strong>Level:</strong> <span class="badge bg-info text-dark">@selectedParticipant.Level</span></p>
                        <p><strong>Created At:</strong> @DateTime.Now.ToShortDateString()</p>
                    </div>
                </div>
                <button class="btn btn-secondary btn-sm" @onclick="CloseDetails">Close Details</button>
            </div>
        </div>
    }

    @* Form for Create/Edit Operations *@
    @if (showForm)
    {
        <div class="card mb-4 shadow-sm border-primary">
            <div class="card-header bg-primary text-white">
                @(isEditing ? "Edit Participant" : "Register New Participant")
            </div>
            <div class="card-body">
                <EditForm Model="@currentParticipant" OnValidSubmit="HandleSave">
                    <DataAnnotationsValidator />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Name</label>
                            <InputText @bind-Value="currentParticipant.Name" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Last Name</label>
                            <InputText @bind-Value="currentParticipant.LastName" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email</label>
                            <InputText @bind-Value="currentParticipant.Email" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Password</label>
                            <InputText @bind-Value="currentParticipant.Password" type="password" class="form-control" placeholder="Required for new / Blank to keep current" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Age</label>
                            <InputNumber @bind-Value="currentParticipant.Age" class="form-control" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Phone</label>
                            <InputText @bind-Value="currentParticipant.Phone" class="form-control" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Level</label>
                            <InputText @bind-Value="currentParticipant.Level" class="form-control" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">Save Participant</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseForm">Cancel</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @* Main Participants Table *@
    @if (participants == null)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Fetching data from server...</p>
        </div>
    }
    else
    {
        <table class="table table-hover shadow-sm border">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Level</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in participants)
                {
                    <tr>
                        <td class="align-middle">@p.Name @p.LastName</td>
                        <td class="align-middle">@p.Email</td>
                        <td class="align-middle"><span class="badge bg-info text-dark">@p.Level</span></td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-info me-1" @onclick="() => ViewDetails(p)">View</button>
                            <button class="btn btn-sm btn-warning me-1" @onclick="() => EditParticipant(p)">Edit</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteParticipant(p.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<ParticipantDto>? participants;
    private ParticipantDto currentParticipant = new();
    private ParticipantDto? selectedParticipant;
    
    // UI State variables
    private bool showForm = false;
    private bool isEditing = false;
    private bool showDetails = false;
    private int? searchId;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadParticipants();
    }

    // GET all active participants
    private async Task LoadParticipants()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<IEnumerable<ParticipantDto>>>("api/Participants");
            if (response != null && response.Success)
            {
                participants = response.Data.ToList();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error loading list: " + ex.Message;
        }
    }

    // GET participant by ID (Search function)
    private async Task FetchParticipantById()
    {
        if (searchId == null || searchId <= 0)
        {
            errorMessage = "Please enter a valid numeric ID.";
            return;
        }

        errorMessage = null;
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<ParticipantDto>>($"api/Participants/{searchId}");
            if (response != null && response.Success)
            {
                selectedParticipant = response.Data;
                showDetails = true;
                showForm = false;
                searchId = null;
            }
            else
            {
                errorMessage = response?.Message ?? "Participant not found.";
            }
        }
        catch (Exception)
        {
            errorMessage = "ID not found or server error.";
        }
    }

    // POST (Create) or PUT (Update) handler
    private async Task HandleSave()
    {
        try
        {
            HttpResponseMessage response;
            if (isEditing)
            {
                response = await Http.PutAsJsonAsync($"api/Participants/{currentParticipant.Id}", currentParticipant);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/Participants", currentParticipant);
            }

            if (response.IsSuccessStatusCode)
            {
                await LoadParticipants();
                CloseForm();
            }
            else
            {
                errorMessage = "Could not save. Check required fields.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Transaction failed: " + ex.Message;
        }
    }

    // DELETE participant (Soft delete via API)
    private async Task DeleteParticipant(int id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/Participants/{id}");
            if (response.IsSuccessStatusCode)
            {
                await LoadParticipants();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Delete failed: " + ex.Message;
        }
    }

    // UI Helpers
    private void ShowCreateForm()
    {
        currentParticipant = new ParticipantDto();
        isEditing = false;
        showDetails = false;
        showForm = true;
    }

    private void EditParticipant(ParticipantDto p)
    {
        // Copying values to avoid modifying the table row before saving
        currentParticipant = new ParticipantDto
        {
            Id = p.Id,
            Name = p.Name,
            LastName = p.LastName,
            Email = p.Email,
            Age = p.Age,
            Phone = p.Phone,
            Level = p.Level,
            Password = p.Password
        };
        isEditing = true;
        showDetails = false;
        showForm = true;
    }

    private void ViewDetails(ParticipantDto p)
    {
        selectedParticipant = p;
        showDetails = true;
        showForm = false;
    }

    private void CloseForm() => showForm = false;
    private void CloseDetails() => showDetails = false;
}