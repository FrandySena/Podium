@page "/topics"
@using Podium.Application
@using Podium.Application.Responses
@inject HttpClient Http

<PageTitle>Topics Management - Podium</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Topics Management</h1>
        <div class="d-flex gap-2">
            <div class="input-group input-group-sm" style="width: 250px;">
                <input type="number" class="form-control" placeholder="Search by ID..." @bind="searchId" />
                <button class="btn btn-outline-primary" @onclick="FetchTopicById">Search</button>
            </div>
            <button class="btn btn-success" @onclick="ShowCreateForm">New Topic</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (showDetails && selectedTopic != null)
    {
        <div class="card mb-4 border-info shadow-sm bg-light">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Topic Details (ID: @selectedTopic.Id)</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseDetails"></button>
            </div>
            <div class="card-body">
                <p><strong>Name:</strong> @selectedTopic.Name</p>
                <p><strong>Description:</strong> @selectedTopic.Description</p>
                <button class="btn btn-secondary btn-sm" @onclick="CloseDetails">Close Details</button>
            </div>
        </div>
    }

    @if (showForm)
    {
        <div class="card mb-4 shadow-sm border-primary">
            <div class="card-header bg-primary text-white">
                @(isEditing ? "Edit Topic" : "Register New Topic")
            </div>
            <div class="card-body">
                <EditForm Model="@currentTopic" OnValidSubmit="HandleSave">
                    <DataAnnotationsValidator />
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Name</label>
                            <InputText @bind-Value="currentTopic.Name" class="form-control" />
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Description</label>
                            <InputTextArea @bind-Value="currentTopic.Description" class="form-control" rows="3" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">Save Topic</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseForm">Cancel</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (topics == null)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Loading data...</p>
        </div>
    }
    else
    {
        <table class="table table-hover shadow-sm border">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in topics)
                {
                    <tr>
                        <td class="align-middle">@t.Name</td>
                        <td class="align-middle">@t.Description</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-info me-1" @onclick="() => ViewDetails(t)">View</button>
                            <button class="btn btn-sm btn-warning me-1" @onclick="() => EditTopic(t)">Edit</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteTopic(t.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<TopicDto>? topics;
    private TopicDto currentTopic = new();
    private TopicDto? selectedTopic;
    private bool showForm = false;
    private bool isEditing = false;
    private bool showDetails = false;
    private int? searchId;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadTopics();
    }

    private async Task LoadTopics()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<IEnumerable<TopicDto>>>("api/Topics");
            if (response != null && response.Success)
            {
                topics = response.Data.ToList();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error: " + ex.Message;
        }
    }

    private async Task FetchTopicById()
    {
        if (searchId == null || searchId <= 0)
        {
            errorMessage = "Enter a valid ID.";
            return;
        }

        errorMessage = null;
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<TopicDto>>($"api/Topics/{searchId}");
            if (response != null && response.Success)
            {
                selectedTopic = response.Data;
                showDetails = true;
                showForm = false;
                searchId = null;
            }
            else
            {
                errorMessage = response?.Message ?? "Not found.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Error searching ID.";
        }
    }

    private async Task HandleSave()
    {
        try
        {
            HttpResponseMessage response;
            if (isEditing)
            {
                response = await Http.PutAsJsonAsync($"api/Topics/{currentTopic.Id}", currentTopic);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/Topics", currentTopic);
            }

            if (response.IsSuccessStatusCode)
            {
                await LoadTopics();
                CloseForm();
            }
            else
            {
                errorMessage = "Check fields.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Failed: " + ex.Message;
        }
    }

    private async Task DeleteTopic(int id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/Topics/{id}");
            if (response.IsSuccessStatusCode)
            {
                await LoadTopics();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Delete failed: " + ex.Message;
        }
    }

    private void ShowCreateForm()
    {
        currentTopic = new TopicDto();
        isEditing = false;
        showDetails = false;
        showForm = true;
    }

    private void EditTopic(TopicDto t)
    {
        currentTopic = new TopicDto
        {
            Id = t.Id,
            Name = t.Name,
            Description = t.Description
        };
        isEditing = true;
        showDetails = false;
        showForm = true;
    }

    private void ViewDetails(TopicDto t)
    {
        selectedTopic = t;
        showDetails = true;
        showForm = false;
    }

    private void CloseForm() => showForm = false;
    private void CloseDetails() => showDetails = false;
}