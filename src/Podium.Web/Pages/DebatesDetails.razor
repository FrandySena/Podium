@page "/debates/details"
@using Podium.Application.Responses
@using Podium.Application
@inject HttpClient Http

<PageTitle>Debate Details - Podium</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Debate Explorer</h1>
        <div class="input-group" style="width: 350px;">
            <input type="number" class="form-control" placeholder="Search by Debate ID..." @bind="searchId" />
            <button class="btn btn-primary" @onclick="FetchSingleDebate">Search</button>
            <button class="btn btn-outline-secondary" @onclick="LoadAllDebates">Reset</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (debateList == null)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Loading debates...</p>
        </div>
    }
    else
    {
        @foreach (var debate in debateList)
        {
            <div class="card shadow mb-5 border-0">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">@debate.Title</h4>
                    <span class="badge bg-primary">ID: @debate.Id</span>
                </div>
                <div class="card-body bg-light">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <p class="mb-1 text-muted small uppercase"><strong>Topic</strong></p>
                            <h6>@(debate.Topic?.Name ?? "No Topic")</h6>
                            <p class="text-muted small">@debate.Topic?.Description</p>
                        </div>
                        <div class="col-md-4">
                            <p class="mb-1 text-muted small"><strong>Schedule & Location</strong></p>
                            <p class="mb-0"><i class="bi bi-calendar-event"></i> @debate.ScheduledAt.ToString("f")</p>
                            <p><i class="bi bi-geo-alt"></i> @debate.Location</p>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <p class="mb-1 text-muted small"><strong>Description</strong></p>
                            <p class="small">@debate.Description</p>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-header bg-primary text-white py-1">Participants (@debate.Participants?.Count())</div>
                                <ul class="list-group list-group-flush">
                                    @foreach (var p in debate.Participants ?? new List<DebateParticipantsDto>())
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center py-1 small">
                                            <span><i class="bi bi-person"></i> #@p.ParticipantId</span>
                                            <span class="badge bg-secondary rounded-pill">@p.Role</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-header bg-info text-white py-1">Juries (@debate.Juries?.Count())</div>
                                <ul class="list-group list-group-flush">
                                    @foreach (var j in debate.Juries ?? new List<DebateJuriesDto>())
                                    {
                                        <li class="list-group-item py-1 small">
                                            <i class="bi bi-shield-check"></i> Jury ID: @j.JuryId
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card h-100 shadow-sm border-warning">
                                <div class="card-header bg-warning text-dark py-1">Evaluations (@debate.Evaluations?.Count())</div>
                                <div class="card-body p-2">
                                    @foreach (var ev in debate.Evaluations ?? new List<EvaluationDto>())
                                    {
                                        <div class="border-bottom mb-1 pb-1">
                                            <div class="d-flex justify-content-between">
                                                <span class="small fw-bold">Score: @ev.Score</span>
                                                <span class="text-muted" style="font-size: 0.7rem;">Jury: @ev.JuryId</span>
                                            </div>
                                            <p class="mb-0 small italic text-muted">"@ev.Observation"</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <p class="mb-1 text-muted small"><strong>Attendance Check:</strong></p>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var att in debate.Attendances ?? new List<AttendanceDto>())
                            {
                                <span class="badge @(att.IsPresent ? "bg-success" : "bg-danger")">
                                    P#@att.ParticipantId: @(att.IsPresent ? "Present" : "Absent")
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private int? searchId;
    private string? errorMessage;
    private List<DebateDto>? debateList;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllDebates();
    }

    private async Task LoadAllDebates()
    {
        errorMessage = null;
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<IEnumerable<DebateDto>>>("api/Debates/AllDebatesWithDetail");
            if (response != null && response.Success)
            {
                debateList = response.Data.ToList();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error loading debates: " + ex.Message;
        }
    }

    private async Task FetchSingleDebate()
    {
        if (searchId == null) return;
        errorMessage = null;

        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<DebateDto>>($"api/Debates/GetDebateWithDetailsByID/{searchId}");
            if (response != null && response.Success)
            {
                debateList = new List<DebateDto> { response.Data };
            }
            else
            {
                errorMessage = "Debate not found.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error searching: " + ex.Message;
        }
    }
}